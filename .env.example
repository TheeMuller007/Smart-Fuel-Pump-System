PORT=4000
DATABASE_URL="postgresql://postgres:password@localhost:5432/smart_fuel_db"
JWT_SECRET="change-me-in-production"
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES_DAYS=7

# Pump controller (ESP32) integration
# API key the pump controllers send in the x-api-key header. Leave empty to
# disable the /api/esp32 endpoints entirely (fail closed).
ESP32_API_KEY=""
# HMAC-SHA256 secret used to sign authorization payloads (defaults to ESP32_API_KEY)
DEVICE_SIGNING_SECRET=""
# Optional: pin every controller to one station by UUID (omit for multi-station)
DEVICE_STATION_ID=""
