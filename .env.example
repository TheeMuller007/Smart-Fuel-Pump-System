# Runtime
NODE_ENV=development
PORT=4000

# Database — pick ONE:
#  A) Docker Postgres (docker compose up -d db): host port 5433 -> container 5432
DATABASE_URL=postgresql://postgres:password@127.0.0.1:5433/smart_fuel_db?schema=public
#  B) Your machine's own Postgres on the default port — set your real password:
# DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/smart_fuel_db?schema=public

# Auth
JWT_SECRET=change-me-in-production
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES_DAYS=7

# CORS (comma-separated origins; * allows all)
CORS_ORIGIN=*

# ESP32 device integration
ESP32_API_KEY=
DEVICE_SIGNING_SECRET=
DEVICE_STATION_ID=

# Rate limiting (requests per window)
RATE_LIMIT_WINDOW_MINUTES=15
RATE_LIMIT_MAX=300
